[
  { "method": "tools/list" },
  { "call": "inbox", "save": { "tid": "data.threads.0.shortId" } },
  { "call": "thread_list", "args": { "status": "open", "whoseTurn": "agent" } },
  { "call": "thread_show", "args": { "id": "$tid" } },
  { "sleep": 1100 },
  {
    "call": "thread_reply",
    "args": { "id": "$tid", "body": "Added the guard.", "clientId": "mcp-r1" }
  },
  { "sleep": 1100 },
  {
    "call": "thread_reply",
    "args": { "id": "$tid", "body": "Added the guard.", "clientId": "mcp-r1" }
  },
  { "sleep": 1100 },
  {
    "call": "thread_create",
    "args": {
      "path": "src/app.ts",
      "line": 3,
      "body": "Agent-started thread.",
      "severity": "low",
      "clientId": "mcp-c1"
    }
  },
  { "sleep": 1100 },
  { "call": "thread_resolve", "args": { "id": "$tid", "body": "Done." } },
  { "sleep": 1100 },
  {
    "call": "thread_reopen",
    "args": { "id": "$tid", "body": "Not done after all." }
  },
  {
    "call": "thread_show",
    "args": { "id": "nope-nope" },
    "expectError": true,
    "expectCode": "THREAD_NOT_FOUND"
  },
  {
    "call": "thread_reply",
    "args": { "id": "$tid" },
    "expectError": true,
    "expectCode": "INVALID_INPUT"
  }
]
