{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Launch Standard VS Code",
      "type": "node",
      "request": "launch",
      "runtimeExecutable": "code",
      "args": [
        "--extensionDevelopmentPath=${workspaceFolder}"
      ],
      "outFiles": [
        "${workspaceFolder}/out/**/*.js"
      ],
      "preLaunchTask": "npm: build",
      "console": "integratedTerminal"
    },
    {
      "name": "Attach to Standard VS Code (Advanced)",
      "type": "node",
      "request": "attach",
      "port": 9229,
      "restart": true,
      "outFiles": [
        "${workspaceFolder}/out/**/*.js"
      ]
    }
  ]
}