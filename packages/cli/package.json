{
  "name": "@pablou/lhr",
  "version": "0.23.6",
  "description": "Local human-in-the-loop code review CLI and MCP server",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/pabloubal/local-hitl-review.git",
    "directory": "packages/cli"
  },
  "type": "module",
  "bin": {
    "lhr": "dist/lhr.mjs"
  },
  "files": [
    "dist/lhr.mjs"
  ],
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "node esbuild.mjs",
    "lint": "tsc --noEmit",
    "test:unit": "node esbuild.mjs && node --test test/*.test.mjs",
    "test": "npm run test:unit",
    "smoke:pack": "node scripts/smoke-pack.mjs"
  },
  "devDependencies": {
    "@modelcontextprotocol/sdk": "^1.32.0",
    "@types/node": "^22.20.4",
    "esbuild": "^0.25.5",
    "typescript": "^5.8.3",
    "zod": "^4.6.5"
  }
}
